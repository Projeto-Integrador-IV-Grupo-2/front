# Modelo de variáveis de ambiente do frontend.
# Copie para .env e ajuste conforme necessário:  cp .env.example .env
# O arquivo .env NÃO é versionado (ver .gitignore).
#
# Toda variável lida pelo Vite no código do cliente precisa começar com
# VITE_ (https://vite.dev/guide/env-and-mode.html).

# ---- URL base da API (backend Nexo) ----
# Aponta para a raiz da API, sem barra no final. As chamadas do frontend
# completam o caminho (ex.: `${VITE_API_URL}/api/auth/login`).
VITE_API_URL=http://localhost:8080
